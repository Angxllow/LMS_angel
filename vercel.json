{
    "routes": [
        {
            "src": "/manifest.json",
            "dest": "/manifest.json"
        },
        {
            "src": "/favicon.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "/logo192.png",
            "dest": "/logo192.png"
        },
        {
            "src": "/logo512.png",
            "dest": "/logo512.png"
        },
        {
            "src": "/robots.txt",
            "dest": "/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}